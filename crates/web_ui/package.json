{
  "name": "hd2-migrator-web-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "update-info": "bun run scripts/build-update-info.ts",
    "wasm": "wasm-pack build ../hd2-migrator-wasm --target web --out-dir ../web_ui/src/wasm/hd2_migrator_wasm",
    "dev": "bun run update-info && bun run wasm && bunx --bun vite",
    "build": "bun run update-info && bun run wasm && bunx --bun tsc && bunx --bun vite build",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@hd2-mod-tools/migrator-ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "wasm-pack": "^0.15.0",
    "yaml": "^2.8.2"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
