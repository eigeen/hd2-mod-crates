{
  "name": "hd2-migrator-desktop",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "update-info": "bun run ../web_ui/scripts/build-update-info.ts",
    "dev": "bun run update-info && bunx --bun vite",
    "build": "bun run update-info && bunx --bun tsc && bunx --bun vite build",
    "exe:info": "bun run scripts/exe-info.ts",
    "preview": "bunx --bun vite preview",
    "smoke": "bun run scripts/runtime-smoke.ts",
    "desktop": "tauri"
  },
  "dependencies": {
    "@hd2-mod-tools/migrator-ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "@tauri-apps/cli": "^2"
  }
}
