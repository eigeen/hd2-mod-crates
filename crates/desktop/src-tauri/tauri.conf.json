{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD2 Mod Tools Desktop",
  "identifier": "dev.hd2modtools.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HD2 Mod Tools",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "base-uri": ["'self'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "font-src": ["'self'", "data:"],
        "frame-ancestors": ["'none'"],
        "img-src": ["'self'", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "HD2 Mod Tools",
    "homepage": "https://github.com/eigeen/hd2-mod-crates",
    "category": "Utility",
    "shortDescription": "Native appearance migration and mod update tools for Helldivers 2.",
    "longDescription": "Migrate Helldivers 2 appearance mods and update mod archives locally with native performance. Mod files stay on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "startMenuFolder": "HD2 Mod Tools"
      }
    }
  }
}
